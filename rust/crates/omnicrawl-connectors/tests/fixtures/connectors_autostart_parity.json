{
  "constants": {
    "auto_start_env": "OMNICRAWL_AUTO_START_CONNECTORS",
    "disabled_values": [
      "0",
      "disabled",
      "false",
      "no",
      "off"
    ],
    "enabled_values": [
      "1",
      "enabled",
      "on",
      "true",
      "yes"
    ],
    "connector_log_dirname": "logs",
    "platform_names": [
      "Telegram",
      "飞书"
    ],
    "platform_modules": [
      "omnicrawl.connectors.telegram",
      "omnicrawl.connectors.fsapp"
    ],
    "watch_poll_hint": "Rust 侧监督线程按 0.05s 轮询子进程状态（Python 直接用 wait()）。"
  },
  "auto_start_decisions": [
    {
      "raw": null,
      "enabled": true
    },
    {
      "raw": "0",
      "enabled": false
    },
    {
      "raw": "  OFF  ",
      "enabled": false
    },
    {
      "raw": "off",
      "enabled": false
    },
    {
      "raw": "disabled",
      "enabled": false
    },
    {
      "raw": "1",
      "enabled": true
    },
    {
      "raw": "TRUE",
      "enabled": true
    },
    {
      "raw": "on",
      "enabled": true
    },
    {
      "raw": "maybe",
      "enabled": true
    },
    {
      "raw": "",
      "enabled": true
    }
  ],
  "log_paths": [
    {
      "platform": "Telegram",
      "filename": "Telegram.log"
    },
    {
      "platform": "飞书",
      "filename": "飞书.log"
    }
  ],
  "log_dir_name": "logs",
  "child_env_cases": [
    {
      "name": "no_pythonpath",
      "base": {
        "PATH": "/usr/bin"
      },
      "pairs": [
        [
          "PATH",
          "/usr/bin"
        ],
        [
          "PYTHONPATH",
          "<ROOT>"
        ]
      ],
      "launch_cwd_env_present": false,
      "pythonpath": "<ROOT>"
    },
    {
      "name": "existing_pythonpath",
      "base": {
        "PATH": "/usr/bin",
        "PYTHONPATH": "  /existing  "
      },
      "pairs": [
        [
          "PATH",
          "/usr/bin"
        ],
        [
          "PYTHONPATH",
          "<ROOT>;/existing"
        ]
      ],
      "launch_cwd_env_present": false,
      "pythonpath": "<ROOT>;/existing"
    },
    {
      "name": "blank_pythonpath_and_launch_cwd",
      "base": {
        "PYTHONPATH": "   ",
        "AI_VOICE_CHAT_LAUNCH_CWD": "/somewhere"
      },
      "pairs": [
        [
          "PYTHONPATH",
          "<ROOT>"
        ]
      ],
      "launch_cwd_env_present": false,
      "pythonpath": "<ROOT>"
    },
    {
      "name": "pythonpath_list_and_launch_cwd",
      "base": {
        "PYTHONPATH": "/a:/b",
        "AI_VOICE_CHAT_LAUNCH_CWD": "/x",
        "KEEP": "1"
      },
      "pairs": [
        [
          "PYTHONPATH",
          "<ROOT>;/a:/b"
        ],
        [
          "KEEP",
          "1"
        ]
      ],
      "launch_cwd_env_present": false,
      "pythonpath": "<ROOT>;/a:/b"
    }
  ],
  "scenarios": [
    {
      "name": "none_configured",
      "config": null,
      "env_overrides": {},
      "capture_logs": false,
      "capture_logs_flag": false,
      "started": [],
      "started_after_close": [],
      "diagnostics": [],
      "diagnostics_after_close": [],
      "spawns": []
    },
    {
